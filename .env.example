# Postgres admin connection - used by migrations, ingest/transform/embed scripts, and to
# create the reader/writer roles migrations/003 and migrations/006 define.
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=devuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb

# Reader role (appdb_reader, read-only - migrations/003_readonly_role.sql) - the agent's
# actual runtime trust boundary. Required: tools.py reads these with no default and raises
# KeyError immediately if unset.
POSTGRES_READER_USER=appdb_reader
POSTGRES_READER_PASSWORD=changeme

# Writer role (appdb_agent_writer, CREATE+USAGE on agent_scratch only -
# migrations/006_agent_scratch_role.sql) - lets the agent persist its own derived results
# and chat history without ever touching appdb_reader's grants. Required, same as above.
POSTGRES_AGENT_WRITER_USER=appdb_agent_writer
POSTGRES_AGENT_WRITER_PASSWORD=changeme

# Anthropic API key - required by both agent.py (the main agent) and verify_answer.py (the
# Build 7 verifier); the anthropic SDK reads this from the environment automatically, so it
# won't show up in a grep for os.getenv/os.environ, but nothing runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional - the secondary SQL Server lab environment (legacy/, not part of the agent itself).
MSSQL_SA_PASSWORD=Your_Strong!Passw0rd
